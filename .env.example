# ── Supabase ────────────────────────────────────────────────────────────
# Supabase 대시보드 > Project Settings > API 에서 확인할 수 있어요.

# 프로젝트 URL (브라우저에도 노출됩니다)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# anon(public) 키 — 공개 콘텐츠 읽기 / 익명 민원 작성에 사용 (노출되어도 되는 키)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# service_role 키 — 관리자 등록·수정·삭제 및 민원 열람에만 사용
# ⚠️ 절대 클라이언트에 노출하면 안 됩니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── 관리자 로그인 ───────────────────────────────────────────────────────
# /admin 페이지 로그인 비밀번호
ADMIN_PASSWORD=여기에-길고-추측하기-어려운-비밀번호

# 로그인 세션 쿠키 서명용 비밀값 (선택)
# 비워두면 ADMIN_PASSWORD 를 사용합니다. 비밀번호를 바꾸면 기존 세션이 만료돼요.
# 만들기: openssl rand -base64 32
ADMIN_SESSION_SECRET=
